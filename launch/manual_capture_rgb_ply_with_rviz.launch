<?xml version="1.0"?>
<launch>
  <arg name="cloud_topic" default="/camera/depth/color/points" />
  <arg name="out_dir" default="$(find tabletop_workspace_opt)/captured_rgb_ply" />
  <arg name="clear_out_dir_on_start" default="false" />
  <arg name="save_in_world_frame" default="true" />
  <arg name="world_frame" default="sawyer_base_link" />
  <arg name="use_latest_tf_for_cloud" default="false" />
  <arg name="rviz_config" default="$(find tabletop_workspace_opt)/config/handeye_debug.rviz" />

  <!--
    Start RGB PLY capture, debug hand-eye TF candidates, and RViz together.
    This lets you see the camera-related frames while manually collecting raw PLYs.
  -->

  <include file="$(find tabletop_workspace_opt)/launch/test_handeye_tf.launch" />

  <include file="$(find tabletop_workspace_opt)/launch/manual_capture_rgb_ply.launch">
    <arg name="cloud_topic" value="$(arg cloud_topic)" />
    <arg name="out_dir" value="$(arg out_dir)" />
    <arg name="clear_out_dir_on_start" value="$(arg clear_out_dir_on_start)" />
    <arg name="save_in_world_frame" value="$(arg save_in_world_frame)" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="use_latest_tf_for_cloud" value="$(arg use_latest_tf_for_cloud)" />
  </include>

  <include file="$(find tabletop_workspace_opt)/launch/handeye_debug_rviz.launch">
    <arg name="rviz_config" value="$(arg rviz_config)" />
  </include>
</launch>

<?xml version="1.0"?>
<launch>
  <arg name="base_frame" default="base"/>
  <arg name="end_effector_topic" default="/robot/limb/right/endpoint_state"/>
  <arg name="limb" default="right"/>
  <arg name="joy_dev" default="/dev/input/js0"/>
  <arg name="joystick_type" default="xbox"/>
  <arg name="launch_joystick" default="true"/>
  <arg name="launch_relaxed_ik" default="true"/>
  <arg name="launch_intent_viz" default="true"/>
  <arg name="launch_sam_sandwich" default="true"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="launch_thin_layer_placement" default="false"/>
  <arg name="setting_file_path" default="$(find relaxed_ik_ros1)/relaxed_ik_core/configs/settings.yaml"/>
  <arg name="joint_max_abs_vel" default="0.5"/>
  <arg name="selected_grasp_label_topic" default="/shared_autonomy/selected_grasp_label"/>
  <arg name="candidate_ids" default="[30, 31, 32, 33, 34, 35]"/>
  <arg name="task_allowed_ids_topic" default="/task_context/allowed_tag_ids"/>
  <arg name="task_phase_topic" default="/task_context/phase"/>
  <arg name="task_prompt_topic" default="/task_context/prompt"/>
  <arg name="object_map_yaml" default="$(find tabletop_workspace_opt)/config/sandwich_candidate_metadata.example.yaml"/>
  <arg name="stack_config_yaml" default="$(find tabletop_workspace_opt)/config/sandwich_stack_profiles.example.yaml"/>
  <arg name="beta" default="2.0"/>
  <arg name="window_sec" default="1.2"/>
  <arg name="stationary_speed_mps" default="0.03"/>
  <arg name="reset_hold_sec" default="2.0"/>
  <arg name="warmup_sec" default="0.0"/>
  <arg name="joystick_direction_weight" default="6.0"/>
  <arg name="joystick_direction_threshold" default="0.10"/>
  <arg name="joystick_direction_x_axis" default="1"/>
  <arg name="joystick_direction_y_axis" default="0"/>
  <arg name="joystick_direction_x_sign" default="1.0"/>
  <arg name="joystick_direction_y_sign" default="1.0"/>
  <arg name="joystick_intent_model" default="projected_position"/>
  <arg name="joystick_projection_speed_mps" default="0.08"/>
  <arg name="joystick_projection_min_sec" default="0.25"/>
  <arg name="joystick_projection_hold_cap_sec" default="0.75"/>
  <arg name="joystick_projection_use_magnitude" default="false"/>
  <arg name="select_threshold" default="0.60"/>
  <arg name="auto_select_pregrasp" default="false"/>
  <arg name="auto_select_hold_sec" default="0.50"/>
  <arg name="auto_select_phases" default="select_sandwich_item"/>
  <arg name="intent_select_mode" default="threshold"/>
  <arg name="joystick_event_axis_indices" default="0,1"/>
  <arg name="joystick_event_threshold" default="0.25"/>
  <arg name="joystick_event_hold_sec" default="0.30"/>
  <arg name="joystick_retarget_threshold" default="0.0"/>
  <arg name="joystick_retarget_hold_sec" default="0.30"/>
  <arg name="joystick_retarget_input_threshold" default="0.10"/>
  <arg name="joystick_event_min_probability" default="0.30"/>
  <arg name="joystick_start_on_release" default="true"/>
  <arg name="joystick_release_threshold" default="0.08"/>
  <arg name="joystick_recent_input_window_sec" default="1.25"/>
  <arg name="joystick_stable_select_hold_sec" default="0.12"/>
  <arg name="joystick_retarget_on_release" default="false"/>
  <arg name="joystick_retarget_release_window_sec" default="0.70"/>
  <arg name="joystick_event_cooldown_sec" default="0.35"/>
  <arg name="joystick_event_sample_delay_sec" default="0.0"/>
  <arg name="selection_lock_start_timeout_sec" default="1.0"/>
  <arg name="breakfast_milk_pose_lift_z" default="0.05"/>
  <arg name="breakfast_milk_min_pregrasp_z" default="0.08"/>
  <arg name="breakfast_milk_min_grasp_z" default="-0.045"/>
  <arg name="breakfast_milk_pregrasp_ignore_orientation" default="true"/>
  <arg name="breakfast_milk_grasp_max_speed_mps" default="0.30"/>
  <arg name="confirm_button_index" default="2"/>
  <arg name="cancel_button_index" default="3"/>
  <arg name="close_button_index" default="0"/>
  <arg name="enable_gripper_actions" default="true"/>
  <arg name="auto_close_gripper_on_grasp" default="true"/>
  <arg name="exec_pregrasp_topic" default="/tag_grasp_demo/pregrasp_pose"/>
  <arg name="exec_grasp_topic" default="/tag_grasp_demo/grasp_pose"/>
  <arg name="show_executor_status_window" default="false"/>
  <arg name="show_intent_probability_window" default="true"/>
  <arg name="show_intent_workspace_map_window" default="false"/>
  <arg name="enable_min_ee_z" default="false"/>
  <arg name="min_ee_z" default="0.02"/>
  <arg name="enable_teleop_z_limit" default="true"/>
  <arg name="teleop_min_ee_z" default="0.08"/>
  <arg name="use_pregrasp_approach_hover" default="false"/>
  <arg name="pregrasp_approach_offset_z" default="0.12"/>
  <arg name="pregrasp_approach_min_z" default="0.16"/>
  <arg name="max_speed_mps" default="0.2"/>
  <arg name="max_angular_step" default="0.24"/>
  <arg name="position_tolerance_m" default="0.01"/>
  <arg name="orientation_tolerance_rad" default="0.25"/>
  <arg name="pregrasp_position_tolerance_m" default="0.015"/>
  <arg name="pregrasp_orientation_tolerance_rad" default="0.35"/>
  <arg name="pregrasp_min_execute_sec" default="0.40"/>
  <arg name="stall_timeout_sec" default="12.0"/>
  <arg name="retarget_retreat_enabled" default="true"/>
  <arg name="retarget_retreat_offset_z" default="0.08"/>
  <arg name="retarget_retreat_min_z" default="0.12"/>
  <arg name="retarget_retreat_move_sec" default="0.8"/>
  <arg name="pause_auto_pregrasp_on_manual_assist" default="false"/>
  <arg name="manual_grasp_after_pregrasp" default="true"/>
  <arg name="use_goal_orientation" default="true"/>
  <arg name="force_topdown_quat_xyzw" default="0.0, 1.0, 0.0, 0.0"/>

  <include if="$(arg launch_sam_sandwich)" file="$(find tabletop_workspace_opt)/launch/sam_sandwich_grasp.launch">
    <arg name="launch_rviz" value="$(arg launch_rviz)"/>
    <arg name="candidate_metadata_yaml" value="$(arg object_map_yaml)"/>
  </include>

  <param name="setting_file_path" value="$(arg setting_file_path)"/>
  <param name="/tabletop_workspace_opt/control_mode" value="shared_autonomy"/>

  <node if="$(arg launch_joystick)" pkg="joy" type="joy_node" name="xbox" output="screen">
    <param name="dev" value="$(arg joy_dev)"/>
  </node>

  <node if="$(arg launch_relaxed_ik)"
        pkg="tabletop_workspace_opt"
        type="joint_velocity_controller.py"
        name="joint_velocity_controller"
        output="screen">
    <param name="max_abs_vel" value="$(arg joint_max_abs_vel)"/>
    <param name="log_v_cmd" value="false"/>
  </node>

  <node if="$(arg launch_relaxed_ik)"
        pkg="relaxed_ik_ros1"
        type="relaxed_ik_rust.py"
        name="relaxed_ik_rust"
        output="screen">
    <param name="use_visualization" value="false"/>
  </node>

  <node if="$(arg launch_joystick)"
        pkg="tabletop_workspace_opt"
        type="joystick_teleop_node.py"
        name="joystick_teleop"
        output="screen"
        args="-j $(arg joystick_type) -l $(arg limb)">
    <param name="required_control_mode" value="shared_autonomy"/>
    <param name="enable_teleop_z_limit" value="$(arg enable_teleop_z_limit)"/>
    <param name="teleop_min_ee_z" value="$(arg teleop_min_ee_z)"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="apriltag_intent_inference.py"
        name="sandwich_intent_inference"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="end_effector_topic" value="$(arg end_effector_topic)"/>
    <param name="joy_topic" value="joy"/>
    <param name="candidates_topic" value="/sam_sandwich_grasp/detections"/>
    <param name="allowed_ids_topic" value="$(arg task_allowed_ids_topic)"/>
    <param name="selected_grasp_label_topic" value="$(arg selected_grasp_label_topic)"/>
    <param name="beta" value="$(arg beta)"/>
    <param name="window_sec" value="$(arg window_sec)"/>
    <param name="stationary_speed_mps" value="$(arg stationary_speed_mps)"/>
    <param name="reset_hold_sec" value="$(arg reset_hold_sec)"/>
    <param name="warmup_sec" value="$(arg warmup_sec)"/>
    <param name="joystick_direction_weight" value="$(arg joystick_direction_weight)"/>
    <param name="joystick_direction_threshold" value="$(arg joystick_direction_threshold)"/>
    <param name="joystick_direction_x_axis" value="$(arg joystick_direction_x_axis)"/>
    <param name="joystick_direction_y_axis" value="$(arg joystick_direction_y_axis)"/>
    <param name="joystick_direction_x_sign" value="$(arg joystick_direction_x_sign)"/>
    <param name="joystick_direction_y_sign" value="$(arg joystick_direction_y_sign)"/>
    <param name="joystick_intent_model" value="$(arg joystick_intent_model)"/>
    <param name="joystick_projection_speed_mps" value="$(arg joystick_projection_speed_mps)"/>
    <param name="joystick_projection_min_sec" value="$(arg joystick_projection_min_sec)"/>
    <param name="joystick_projection_hold_cap_sec" value="$(arg joystick_projection_hold_cap_sec)"/>
    <param name="joystick_projection_use_magnitude" value="$(arg joystick_projection_use_magnitude)"/>
    <param name="execution_state_topic" value="/sandwich_intent_inference/execution_state"/>
    <param name="task_phase_topic" value="$(arg task_phase_topic)"/>
    <param name="object_map_yaml" value="$(arg object_map_yaml)"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="apriltag_intent_grasp_bridge.py"
        name="sandwich_intent_grasp_bridge"
        output="screen">
    <param name="tag_ids" value="$(arg candidate_ids)"/>
    <param name="input_namespace_prefix" value="/sam_sandwich_candidates/candidate_"/>
    <param name="top_goal_topic" value="/sandwich_intent_inference/top_goal"/>
    <param name="top_probability_topic" value="/sandwich_intent_inference/top_probability"/>
    <param name="selection_ready_topic" value="/sandwich_intent_inference/selection_ready"/>
    <param name="joy_topic" value="joy"/>
    <param name="output_pregrasp_topic" value="$(arg exec_pregrasp_topic)"/>
    <param name="output_grasp_topic" value="$(arg exec_grasp_topic)"/>
    <param name="prompt_topic" value="/sandwich_intent_inference/confirmation_prompt"/>
    <param name="selected_grasp_label_topic" value="$(arg selected_grasp_label_topic)"/>
    <param name="select_threshold" value="$(arg select_threshold)"/>
    <param name="auto_select_pregrasp" value="$(arg auto_select_pregrasp)"/>
    <param name="auto_select_hold_sec" value="$(arg auto_select_hold_sec)"/>
    <param name="auto_select_phases" value="$(arg auto_select_phases)"/>
    <param name="intent_select_mode" value="$(arg intent_select_mode)"/>
    <param name="joystick_event_axis_indices" value="$(arg joystick_event_axis_indices)"/>
    <param name="joystick_event_threshold" value="$(arg joystick_event_threshold)"/>
    <param name="joystick_event_hold_sec" value="$(arg joystick_event_hold_sec)"/>
    <param name="joystick_retarget_threshold" value="$(arg joystick_retarget_threshold)"/>
    <param name="joystick_retarget_hold_sec" value="$(arg joystick_retarget_hold_sec)"/>
    <param name="joystick_retarget_input_threshold" value="$(arg joystick_retarget_input_threshold)"/>
    <param name="joystick_event_min_probability" value="$(arg joystick_event_min_probability)"/>
    <param name="joystick_start_on_release" value="$(arg joystick_start_on_release)"/>
    <param name="joystick_release_threshold" value="$(arg joystick_release_threshold)"/>
    <param name="joystick_recent_input_window_sec" value="$(arg joystick_recent_input_window_sec)"/>
    <param name="joystick_stable_select_hold_sec" value="$(arg joystick_stable_select_hold_sec)"/>
    <param name="joystick_retarget_on_release" value="$(arg joystick_retarget_on_release)"/>
    <param name="joystick_retarget_release_window_sec" value="$(arg joystick_retarget_release_window_sec)"/>
    <param name="joystick_event_cooldown_sec" value="$(arg joystick_event_cooldown_sec)"/>
    <param name="joystick_event_sample_delay_sec" value="$(arg joystick_event_sample_delay_sec)"/>
    <param name="selection_lock_start_timeout_sec" value="$(arg selection_lock_start_timeout_sec)"/>
    <param name="breakfast_milk_pose_lift_z" value="$(arg breakfast_milk_pose_lift_z)"/>
    <param name="breakfast_milk_min_pregrasp_z" value="$(arg breakfast_milk_min_pregrasp_z)"/>
    <param name="breakfast_milk_min_grasp_z" value="$(arg breakfast_milk_min_grasp_z)"/>
    <param name="breakfast_milk_pregrasp_ignore_orientation" value="$(arg breakfast_milk_pregrasp_ignore_orientation)"/>
    <param name="breakfast_milk_grasp_max_speed_mps" value="$(arg breakfast_milk_grasp_max_speed_mps)"/>
    <param name="confirm_button_index" value="$(arg confirm_button_index)"/>
    <param name="cancel_button_index" value="$(arg cancel_button_index)"/>
    <param name="object_map_yaml" value="$(arg object_map_yaml)"/>
    <param name="force_topdown_categories" value="sandwich_bread, sandwich_filling"/>
    <param name="force_topdown_quat_xyzw" value="$(arg force_topdown_quat_xyzw)"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="apriltag_filtered_executor.py"
        name="sandwich_filtered_executor"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="end_effector_topic" value="$(arg end_effector_topic)"/>
    <param name="pregrasp_topic" value="$(arg exec_pregrasp_topic)"/>
    <param name="grasp_topic" value="$(arg exec_grasp_topic)"/>
    <param name="joy_topic" value="joy"/>
    <param name="confirm_button_index" value="$(arg confirm_button_index)"/>
    <param name="cancel_button_index" value="$(arg cancel_button_index)"/>
    <param name="close_button_index" value="$(arg close_button_index)"/>
    <param name="limb" value="$(arg limb)"/>
    <param name="enable_gripper_actions" value="$(arg enable_gripper_actions)"/>
    <param name="auto_close_gripper_on_grasp" value="$(arg auto_close_gripper_on_grasp)"/>
    <param name="max_speed_mps" value="$(arg max_speed_mps)"/>
    <param name="max_angular_step" value="$(arg max_angular_step)"/>
    <param name="position_tolerance_m" value="$(arg position_tolerance_m)"/>
    <param name="orientation_tolerance_rad" value="$(arg orientation_tolerance_rad)"/>
    <param name="pregrasp_position_tolerance_m" value="$(arg pregrasp_position_tolerance_m)"/>
    <param name="pregrasp_orientation_tolerance_rad" value="$(arg pregrasp_orientation_tolerance_rad)"/>
    <param name="pregrasp_min_execute_sec" value="$(arg pregrasp_min_execute_sec)"/>
    <param name="stall_timeout_sec" value="$(arg stall_timeout_sec)"/>
    <param name="retarget_retreat_enabled" value="$(arg retarget_retreat_enabled)"/>
    <param name="retarget_retreat_offset_z" value="$(arg retarget_retreat_offset_z)"/>
    <param name="retarget_retreat_min_z" value="$(arg retarget_retreat_min_z)"/>
    <param name="retarget_retreat_move_sec" value="$(arg retarget_retreat_move_sec)"/>
    <param name="pause_auto_pregrasp_on_manual_assist" value="$(arg pause_auto_pregrasp_on_manual_assist)"/>
    <param name="manual_grasp_after_pregrasp" value="$(arg manual_grasp_after_pregrasp)"/>
    <param name="use_goal_orientation" value="$(arg use_goal_orientation)"/>
    <param name="enable_min_ee_z" value="$(arg enable_min_ee_z)"/>
    <param name="min_ee_z" value="$(arg min_ee_z)"/>
    <param name="use_pregrasp_approach_hover" value="$(arg use_pregrasp_approach_hover)"/>
    <param name="pregrasp_approach_offset_z" value="$(arg pregrasp_approach_offset_z)"/>
    <param name="pregrasp_approach_min_z" value="$(arg pregrasp_approach_min_z)"/>
    <param name="auto_start_pregrasp_on_new_target" value="false"/>
    <param name="allow_retarget_during_pregrasp" value="$(eval arg('intent_select_mode') == 'joystick_event')"/>
    <param name="show_status_window" value="$(arg show_executor_status_window)"/>
    <param name="prompt_topic" value="/sandwich_executor/prompt"/>
    <param name="execution_state_topic" value="/sandwich_intent_inference/execution_state"/>
    <param name="task_phase_topic" value="$(arg task_phase_topic)"/>
    <param name="selected_grasp_label_topic" value="$(arg selected_grasp_label_topic)"/>
    <param name="object_map_yaml" value="$(arg object_map_yaml)"/>
    <param name="required_control_mode" value="shared_autonomy"/>
    <param name="prompt_marker_topic" value="/sandwich_filtered_executor/prompt_marker"/>
    <param name="prompt_marker_offset_z" value="0.15"/>
  </node>

  <node if="$(arg launch_intent_viz)"
        pkg="tabletop_workspace_opt"
        type="intent_visualization_node.py"
        name="sandwich_intent_visualization"
        output="screen">
    <param name="candidate_source" value="detections"/>
    <param name="det_topic" value="/sam_sandwich_grasp/detections"/>
    <param name="prob_topic" value="/sandwich_intent_inference/distribution"/>
    <param name="top_goal_topic" value="/sandwich_intent_inference/top_goal"/>
    <param name="tracker_point_topic" value="/sandwich_intent_inference/current_tracker_point"/>
    <param name="top_pose_topic" value="/sandwich_intent_inference/top_pose"/>
    <param name="confirmation_prompt_topic" value="/sandwich_intent_inference/confirmation_prompt"/>
    <param name="allowed_ids_topic" value="$(arg task_allowed_ids_topic)"/>
    <param name="task_prompt_topic" value="$(arg task_prompt_topic)"/>
    <param name="show_probability_window" value="$(arg show_intent_probability_window)"/>
    <param name="show_workspace_map_window" value="$(arg show_intent_workspace_map_window)"/>
    <param name="object_map_yaml" value="$(arg object_map_yaml)"/>
  </node>

  <node if="$(arg launch_thin_layer_placement)"
        pkg="tabletop_workspace_opt"
        type="thin_layer_placement_controller.py"
        name="sandwich_thin_layer_placement"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="end_effector_topic" value="$(arg end_effector_topic)"/>
    <param name="joy_topic" value="joy"/>
    <param name="execution_state_topic" value="/sandwich_intent_inference/execution_state"/>
    <param name="selected_grasp_label_topic" value="$(arg selected_grasp_label_topic)"/>
    <param name="candidate_metadata_yaml" value="$(arg object_map_yaml)"/>
    <param name="stack_config_yaml" value="$(arg stack_config_yaml)"/>
    <param name="required_control_mode" value="shared_autonomy"/>
    <param name="auto_trigger_on_grasp_complete" value="true"/>
  </node>
</launch>

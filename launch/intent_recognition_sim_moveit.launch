<?xml version="1.1"?>
<!--
  Full simulation stack with MoveIt obstacle-aware planning and RViz.

  Starts:
    1. RelaxedIK  (still used for keyboard teleoperation)
    2. MuJoCo simulation server  (publishes /collision_object to MoveIt)
    3. MoveIt move_group  (fake controllers – no real robot needed)
    4. RViz with MoveIt plugin
    5. move_to_cartesian_pose service  (uses moveit_commander)
    6. Keyboard teleop  (optional, uses RelaxedIK)
-->
<launch>
  <arg name="scene_name"          default="scene_swapped"/>
  <arg name="setting_file_path"   default="$(find relaxed_ik_ros1)/relaxed_ik_core/configs/settings.yaml"/>
  <arg name="with_mujoco_sim"     default="true"/>
  <arg name="with_static_scene_collision" default="true"/>
  <arg name="electric_gripper"    default="true"/>
  <arg name="tip_name"     if="$(arg electric_gripper)" default="right_gripper_tip"/>
  <arg name="tip_name" unless="$(arg electric_gripper)" default="right_hand"/>
  <arg name="with_keyboard_teleop" default="true"/>
  <arg name="with_realsense_sim"   default="false"/>
  <arg name="with_move_to_cartesian_service" default="false"/>
  <arg name="static_scene_xml_path" default="$(find tabletop_workspace_opt)/src/assets/scenes/$(arg scene_name).xml"/>
  <arg name="realsense_scene_xml_path" default="$(find tabletop_workspace_opt)/src/assets/scenes/scene_swapped.xml"/>
  <arg name="realsense_camera_name" default="realsense_rgb"/>
  <arg name="realsense_width" default="640"/>
  <arg name="realsense_height" default="480"/>
  <arg name="realsense_rate" default="10"/>
  <arg name="realsense_joint_state_topic" default="/relaxed_ik/joint_angle_solutions"/>
  <arg name="realsense_pc_stride" default="2"/>
  <arg name="realsense_z_min" default="0.05"/>
  <arg name="realsense_z_max" default="2.0"/>

  <!-- =====================================================================
       1. RelaxedIK  (velocity IK for keyboard teleoperation)
       ===================================================================== -->
  <param name="setting_file_path" value="$(arg setting_file_path)"/>
  <param name="use_simulator"     value="true"/>

  <node pkg="relaxed_ik_ros1" type="relaxed_ik_rust.py" name="relaxed_ik_rust" output="screen">
    <param name="use_visualization" value="false"/>
    <param name="set_robot_description" value="false"/>
  </node>

  <group if="$(arg with_mujoco_sim)">
    <!-- =====================================================================
         2. MuJoCo simulation server
            Publishes:
              /mujoco_sim/detections      (object positions)
              /mujoco_sim/endpoint_state  (EE pose)
              /collision_object           → MoveIt planning scene
         Subscribes:
              relaxed_ik/joint_angle_solutions  (drives the sim)
         ===================================================================== -->
    <node pkg="tabletop_workspace_opt" type="simulation_server.py"
          name="simulator" output="screen">
      <param name="scene_name" value="$(arg scene_name)"/>
      <rosparam param="object_names">
        - bowl_0_a430d997_0564_4fae_801b_c01693feeee6
        - cutting_board_0_e8afda3b_6dea_4bfc_859f_88a35bb623a0
        - kettle_0_32879d92_873b_4b4d_b373_7aa5fa9312b4
        - blender_0_0fbbacb52bde4dbaae1c7a34b2beb9c4
        - utensil_holder_0_9ade5e08_2b58_4b38_98cb_6d21b4ca3c12
        - rice_cooker_0_b2bd52d777364996962de21c9647b45b
        - toaster_0_f22562f0e0ff43618941d02542123196
      </rosparam>
    </node>

    <!-- Bridge MuJoCo detections to MoveIt planning-scene collision objects -->
    <node pkg="tabletop_workspace_opt" type="detections_to_collision_objects.py"
          name="detections_to_collision_objects" output="screen">
      <param name="world_frame" value="world"/>
      <param name="input_topic" value="/mujoco_sim/detections"/>
      <param name="output_topic" value="/collision_object"/>
      <param name="use_detection_index_as_id" value="true"/>
      <param name="default_size_x" value="0.05"/>
      <param name="default_size_y" value="0.05"/>
      <param name="default_size_z" value="0.05"/>
      <!-- Per-object collision box sizes (x,y,z), keyed by detection id -->
      <rosparam param="id_to_size">
        "0": [0.16, 0.16, 0.10]  # bowl
        "1": [0.30, 0.22, 0.03]  # cutting board
        "2": [0.18, 0.18, 0.22]  # kettle
        "3": [0.16, 0.12, 0.28]  # blender
        "4": [0.11, 0.11, 0.18]  # utensil holder
        "5": [0.20, 0.20, 0.20]  # rice cooker
        "6": [0.20, 0.14, 0.14]  # toaster
      </rosparam>
      <rosparam param="id_to_mesh_file">
        "0": "$(find tabletop_workspace_opt)/src/assets/external/mesatask_assets/assets/meshes/a430d997-0564-4fae-801b-c01693feeee6.obj"
        "1": "$(find tabletop_workspace_opt)/src/assets/external/mesatask_assets/assets/meshes/e8afda3b-6dea-4bfc-859f-88a35bb623a0.obj"
        "2": "$(find tabletop_workspace_opt)/src/assets/external/mesatask_assets/assets/meshes/32879d92-873b-4b4d-b373-7aa5fa9312b4.obj"
        "3": "$(find tabletop_workspace_opt)/src/assets/external/mesatask_assets/assets/meshes/0fbbacb52bde4dbaae1c7a34b2beb9c4.obj"
        "4": "$(find tabletop_workspace_opt)/src/assets/external/mesatask_assets/assets/meshes/9ade5e08-2b58-4b38-98cb-6d21b4ca3c12.obj"
        "5": "$(find tabletop_workspace_opt)/src/assets/external/mesatask_assets/assets/meshes/b2bd52d777364996962de21c9647b45b.obj"
        "6": "$(find tabletop_workspace_opt)/src/assets/external/mesatask_assets/assets/meshes/f22562f0e0ff43618941d02542123196.obj"
      </rosparam>
      <rosparam param="id_to_mesh_scale">
        "0": [0.136904, 0.136879, 0.136881]
        "1": [0.127756, 0.126429, 0.129917]
        "2": [0.114417, 0.114219, 0.114226]
        "3": [0.008350, 0.008457, 0.008563]
        "4": [0.096863, 0.104144, 0.091044]
        "5": [0.000379, 0.000333, 0.000611]
        "6": [0.020459, 0.028143, 0.028436]
      </rosparam>
      <!-- scene_swapped geoms use local quat="0.707107 0.707107 0 0" (wxyz), converted to xyzw -->
      <rosparam param="id_to_orientation_offset">
        "0": [0.707107, 0.0, 0.0, 0.707107]
        "1": [0.707107, 0.0, 0.0, 0.707107]
        "2": [0.707107, 0.0, 0.0, 0.707107]
        "3": [0.707107, 0.0, 0.0, 0.707107]
        "4": [0.707107, 0.0, 0.0, 0.707107]
        "5": [0.707107, 0.0, 0.0, 0.707107]
        "6": [0.707107, 0.0, 0.0, 0.707107]
      </rosparam>
    </node>

    <!-- =====================================================================
         2.1 Optional Realsense simulation node (RGB/depth/pointcloud)
         ===================================================================== -->
    <node if="$(arg with_realsense_sim)"
          pkg="tabletop_workspace_opt" type="realsense_simulation_node.py"
          name="realsense_sim" output="screen">
      <param name="scene_xml_path" value="$(arg realsense_scene_xml_path)"/>
      <param name="camera_name" value="$(arg realsense_camera_name)"/>
      <param name="width" value="$(arg realsense_width)"/>
      <param name="height" value="$(arg realsense_height)"/>
      <param name="rate" value="$(arg realsense_rate)"/>
      <param name="joint_state_topic" value="$(arg realsense_joint_state_topic)"/>
      <param name="pc_stride" value="$(arg realsense_pc_stride)"/>
      <param name="z_min" value="$(arg realsense_z_min)"/>
      <param name="z_max" value="$(arg realsense_z_max)"/>
    </node>
  </group>

  <!-- Static one-shot collision scene publisher (for WSL / no MuJoCo rendering) -->
  <group unless="$(arg with_mujoco_sim)">
    <node if="$(arg with_static_scene_collision)"
          pkg="tabletop_workspace_opt" type="static_scene_to_collision_objects.py"
          name="static_scene_to_collision_objects" output="screen">
      <param name="scene_xml_path" value="$(arg static_scene_xml_path)"/>
      <param name="world_frame" value="world"/>
      <param name="output_topic" value="/static_scene_collision_object"/>
      <param name="object_prefix" value="static_obj"/>
      <param name="only_free_bodies" value="false"/>
      <param name="use_apply_planning_scene" value="true"/>
      <param name="enable_topic_publish" value="false"/>
      <param name="mesh_as_bounding_box" value="false"/>
      <param name="publish_visual_markers" value="true"/>
      <param name="visual_marker_topic" value="/static_scene_visual_markers"/>
      <param name="clear_world_before_apply" value="true"/>
      <param name="apply_retries" value="30"/>
      <param name="apply_retry_interval" value="1.0"/>
      <param name="startup_delay" value="10.0"/>
      <param name="publish_repeats" value="20"/>
      <param name="repeat_interval" value="0.5"/>
    </node>
  </group>

  <!-- =====================================================================
       3. TF infrastructure
          - Static world→base: the Sawyer's 'base' link sits 0.92 m above the
            floor in the MuJoCo model (inside the pedestal body at z=0.92).
            Setting z=0.92 here puts the RViz world origin at floor level so
            collision objects published from MuJoCo in world-frame coordinates
            appear at the correct height relative to the robot.
          - robot_state_publisher reads /robot/joint_states (published by
            simulation_server) and broadcasts per-link TF frames so MoveIt
            can do collision checking and RViz can show the robot model.
       ===================================================================== -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_base"
        args="0 0 0.92 0 0 0 1 world base"/>

  <!-- Bridge naming mismatch: MoveIt uses 'base', while URDF root is often 'base_link'. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_base_link"
        args="0 0 0 0 0 0 1 base base_link"/>

  <!-- Build complete /joint_states from RelaxedIK arm joints -->
  <node pkg="joint_state_publisher" type="joint_state_publisher"
        name="joint_state_publisher" output="screen">
    <rosparam param="source_list">[/relaxed_ik/joint_angle_solutions]</rosparam>
    <rosparam param="zeros">
      right_j0: 0.0
      right_j1: -1.1775
      right_j2: 0.0
      right_j3: 2.1761
      right_j4: 0.0
      right_j5: 0.5663
      right_j6: 3.3124
    </rosparam>
    <param name="rate" value="30"/>
    <param name="publish_default_positions" value="true"/>
  </node>

  <!-- Keep legacy topic available for nodes expecting /robot/joint_states -->
  <node pkg="topic_tools" type="relay" name="relay_joint_states_to_robot_joint_states"
        args="/joint_states /robot/joint_states" output="screen"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher" output="screen"/>

  <!-- Load Sawyer URDF from xacro (this workspace has sawyer.urdf.xacro, not sawyer.urdf) -->
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder $(find sawyer_description)/urdf/sawyer.urdf.xacro electric_gripper:=$(arg electric_gripper)"/>

  <!-- =====================================================================
       4. MoveIt - load robot description + start move_group with fake
          controllers (no real robot required).
       ===================================================================== -->
  <include file="$(find sawyer_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="false"/>
    <arg name="electric_gripper"       value="$(arg electric_gripper)"/>
    <arg name="tip_name"               value="$(arg tip_name)"/>
  </include>

  <include file="$(find sawyer_moveit_config)/launch/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="fake_execution"             value="true"/>
    <arg name="info"                       value="true"/>
  </include>

  <!-- =====================================================================
       4. RViz with MoveIt plugin
       ===================================================================== -->
  <include file="$(find sawyer_moveit_config)/launch/moveit_rviz.launch">
    <arg name="config"      value="true"/>
    <arg name="rviz_config" value="$(find sawyer_moveit_config)/launch/moveit.rviz"/>
  </include>

  <!-- =====================================================================
       5. MoveIt-based move_to_cartesian_pose service
          - plans with MoveIt, streams waypoints back to MuJoCo sim
       ===================================================================== -->
  <node if="$(arg with_move_to_cartesian_service)"
        pkg="tabletop_workspace_opt" type="move_to_cartesian_pose.py"
        name="move_to_cartesian_pose" output="screen"/>

  <!-- =====================================================================
       6. Keyboard teleoperation (optional; still goes through RelaxedIK)
       ===================================================================== -->
  <node if="$(arg with_keyboard_teleop)"
        pkg="tabletop_workspace_opt" type="keyboard_teleop_node.py"
        name="keyboard_teleop" output="screen" args="-l right"/>

</launch>

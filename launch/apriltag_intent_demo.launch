<?xml version="1.0"?>
<launch>
  <arg name="base_frame" default="base"/>
  <arg name="end_effector_topic" default="/robot/limb/right/endpoint_state"/>
  <arg name="limb" default="right"/>
  <arg name="joy_dev" default="/dev/input/js0"/>
  <arg name="joystick_type" default="xbox"/>
  <arg name="launch_joystick" default="true"/>
  <arg name="launch_relaxed_ik" default="true"/>
  <arg name="setting_file_path" default="$(find relaxed_ik_ros1)/relaxed_ik_core/configs/settings.yaml"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="launch_intent_viz" default="true"/>
  <arg name="launch_pour_task" default="true"/>
  <arg name="rviz_config" default="$(find tabletop_workspace_opt)/config/camera_robot.rviz"/>
  <arg name="fixed_grasp_yaml" default="$(find tabletop_workspace_opt)/config/fixed_grasp_candidates.yaml" />
  <arg name="selected_grasp_label_topic" default="/shared_autonomy/selected_grasp_label" />

  <arg name="beta" default="10.0"/>
  <arg name="distance_scale" default="0.12"/>
  <arg name="w_alignment" default="1.5"/>
  <arg name="w_distance" default="1.0"/>
  <arg name="w_stability" default="0.2"/>
  <arg name="min_input_norm" default="0.05"/>
  <arg name="input_hold_sec" default="0.35"/>
  <arg name="registry_stable_count_required" default="3"/>
  <arg name="registry_max_pos_jump_m" default="0.05"/>
  <arg name="registry_max_rot_jump_deg" default="20.0"/>
  <arg name="select_threshold" default="0.60"/>
  <arg name="confirm_button_index" default="2"/>
  <arg name="cancel_button_index" default="3"/>
  <arg name="close_button_index" default="0"/>
  <arg name="exec_pregrasp_topic" default="/tag_grasp_demo/pregrasp_pose"/>
  <arg name="exec_grasp_topic" default="/tag_grasp_demo/grasp_pose"/>
  <arg name="max_speed_mps" default="0.2"/>
  <arg name="max_angular_step" default="0.24"/>
  <arg name="position_tolerance_m" default="0.01"/>
  <arg name="orientation_tolerance_rad" default="0.25"/>
  <arg name="use_goal_orientation" default="true"/>
  <arg name="publish_rate_hz" default="15.0" />
  <arg name="carry_grasp_id" default="carry_pose" />
  <arg name="carry_stage" default="carry_pose" />
  <arg name="pre_pour_grasp_id" default="pre_pour_pose" />
  <arg name="pre_pour_stage" default="pour_pre_pose" />
  <arg name="pour_grasp_id" default="pour_pose" />
  <arg name="pour_stage" default="pour_pose" />
  <arg name="return_grasp_id" default="return_upright_pose" />
  <arg name="return_stage" default="return_upright_pose" />
  <arg name="place_back_grasp_id" default="place_back_pose" />
  <arg name="place_back_stage" default="place_back_pose" />
  <arg name="start_hold_sec" default="1.0" />
  <arg name="hover_hold_sec" default="0.5" />
  <arg name="pre_pour_move_sec" default="4.0" />
  <arg name="pre_pour_hold_sec" default="1.0" />
  <arg name="pour_move_sec" default="2.5" />
  <arg name="pour_hold_sec" default="3.0" />
  <arg name="return_move_sec" default="2.5" />
  <arg name="return_hold_sec" default="1.0" />
  <arg name="return_lift_move_sec" default="1.5" />
  <arg name="return_lift_hold_sec" default="0.5" />
  <arg name="place_back_move_sec" default="4.0" />
  <arg name="release_hold_sec" default="1.0" />
  <arg name="final_hold_sec" default="2.0" />
  <arg name="safe_hover_offset_z" default="0.10" />
  <arg name="safe_travel_min_z" default="0.08" />
  <arg name="place_release_offset_z" default="0.10" />
  <arg name="return_lift_offset_z" default="0.06" />
  <arg name="enable_robot_interface" default="true" />
  <arg name="enable_gripper_actions" default="true" />
  <arg name="auto_prepare_gripper" default="true" />
  <arg name="loop_sequence" default="false" />

  <!--
    Minimum AprilTag intent demo:
    1) detect tags 0/1/2 and generate dynamic pregrasp candidates
    2) aggregate them into /apriltag_candidate_manager/detections
    3) reuse the old intent inference + probability visualization stack

    Note: intent_action_threshold defaults to 1.1 so the old node will NOT
    auto-command a goal. This launch is for observing dynamic intent
    probabilities first.
  -->
  <param name="setting_file_path" value="$(arg setting_file_path)" />
  <param name="/tabletop_workspace_opt/control_mode" value="shared_autonomy" />

  <include file="$(find tabletop_workspace_opt)/launch/apriltag_multi_candidate_demo.launch">
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="end_effector_topic" value="$(arg end_effector_topic)"/>
    <arg name="launch_rviz" value="$(arg launch_rviz)"/>
    <arg name="rviz_config" value="$(arg rviz_config)"/>
  </include>

  <node pkg="tabletop_workspace_opt"
        type="apriltag_grasp_registry.py"
        name="apriltag_grasp_registry"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="input_topic" value="/apriltag_candidate_manager/detections"/>
    <param name="output_topic" value="/apriltag_grasp_registry/detections"/>
    <param name="stable_count_required" value="$(arg registry_stable_count_required)"/>
    <param name="max_pos_jump_m" value="$(arg registry_max_pos_jump_m)"/>
    <param name="max_rot_jump_deg" value="$(arg registry_max_rot_jump_deg)"/>
  </node>

  <node if="$(arg launch_joystick)" pkg="joy" type="joy_node" name="xbox" output="screen">
    <param name="dev" value="$(arg joy_dev)" />
  </node>

  <node if="$(arg launch_relaxed_ik)"
        pkg="tabletop_workspace_opt"
        type="joint_velocity_controller.py"
        name="joint_velocity_controller"
        output="screen">
    <param name="log_v_cmd" value="false"/>
  </node>

  <node if="$(arg launch_relaxed_ik)"
        pkg="relaxed_ik_ros1"
        type="relaxed_ik_rust.py"
        name="relaxed_ik_rust"
        output="screen">
    <param name="use_visualization" value="false" />
  </node>

  <node if="$(arg launch_joystick)"
        pkg="tabletop_workspace_opt"
        type="joystick_teleop_node.py"
        name="joystick_teleop"
        output="screen"
        args="-j $(arg joystick_type) -l $(arg limb)">
    <param name="required_control_mode" value="shared_autonomy" />
  </node>

  <node pkg="tabletop_workspace_opt"
        type="apriltag_intent_grasp_bridge.py"
        name="apriltag_intent_grasp_bridge"
        output="screen">
    <param name="tag_ids" value="[0, 1, 2]"/>
    <param name="input_namespace_prefix" value="/apriltag_candidates/tag_"/>
    <param name="top_goal_topic" value="/apriltag_intent_inference/top_goal"/>
    <param name="top_probability_topic" value="/apriltag_intent_inference/top_probability"/>
    <param name="joy_topic" value="joy"/>
    <param name="output_pregrasp_topic" value="$(arg exec_pregrasp_topic)"/>
    <param name="output_grasp_topic" value="$(arg exec_grasp_topic)"/>
    <param name="prompt_topic" value="/apriltag_intent_inference/confirmation_prompt"/>
    <param name="selected_grasp_label_topic" value="$(arg selected_grasp_label_topic)"/>
    <param name="select_threshold" value="$(arg select_threshold)"/>
    <param name="confirm_button_index" value="$(arg confirm_button_index)"/>
    <param name="cancel_button_index" value="$(arg cancel_button_index)"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="apriltag_filtered_executor.py"
        name="apriltag_filtered_executor"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="end_effector_topic" value="$(arg end_effector_topic)"/>
    <param name="pregrasp_topic" value="$(arg exec_pregrasp_topic)"/>
    <param name="grasp_topic" value="$(arg exec_grasp_topic)"/>
    <param name="joy_topic" value="joy"/>
    <param name="confirm_button_index" value="$(arg confirm_button_index)"/>
    <param name="cancel_button_index" value="$(arg cancel_button_index)"/>
    <param name="close_button_index" value="$(arg close_button_index)"/>
    <param name="max_speed_mps" value="$(arg max_speed_mps)"/>
    <param name="max_angular_step" value="$(arg max_angular_step)"/>
    <param name="position_tolerance_m" value="$(arg position_tolerance_m)"/>
    <param name="orientation_tolerance_rad" value="$(arg orientation_tolerance_rad)"/>
    <param name="use_goal_orientation" value="$(arg use_goal_orientation)"/>
    <param name="prompt_topic" value="/apriltag_executor/prompt"/>
    <param name="execution_state_topic" value="/intent_inference/execution_state"/>
    <param name="selected_grasp_label_topic" value="$(arg selected_grasp_label_topic)"/>
    <param name="required_control_mode" value="shared_autonomy"/>
    <param name="prompt_marker_topic" value="/apriltag_filtered_executor/prompt_marker"/>
    <param name="prompt_marker_offset_z" value="0.15"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="apriltag_intent_inference.py"
        name="apriltag_intent_inference"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="end_effector_topic" value="$(arg end_effector_topic)"/>
    <param name="joy_topic" value="joy"/>
    <param name="candidates_topic" value="/apriltag_grasp_registry/detections"/>
    <param name="beta" value="$(arg beta)"/>
    <param name="distance_scale" value="$(arg distance_scale)"/>
    <param name="w_alignment" value="$(arg w_alignment)"/>
    <param name="w_distance" value="$(arg w_distance)"/>
    <param name="w_stability" value="$(arg w_stability)"/>
    <param name="min_input_norm" value="$(arg min_input_norm)"/>
    <param name="input_hold_sec" value="$(arg input_hold_sec)"/>
  </node>

  <node if="$(arg launch_intent_viz)"
        pkg="tabletop_workspace_opt"
        type="intent_visualization_node.py"
        name="apriltag_intent_visualization"
        output="screen">
    <param name="candidate_source" value="detections"/>
    <param name="det_topic" value="/apriltag_grasp_registry/detections"/>
    <param name="prob_topic" value="/apriltag_intent_inference/distribution"/>
    <param name="top_goal_topic" value="/apriltag_intent_inference/top_goal"/>
    <param name="tracker_point_topic" value="/apriltag_intent_inference/current_tracker_point"/>
    <param name="top_pose_topic" value="/apriltag_intent_inference/top_pose"/>
    <param name="confirmation_prompt_topic" value="/apriltag_intent_inference/confirmation_prompt"/>
  </node>

  <node if="$(arg launch_pour_task)"
        pkg="tabletop_workspace_opt"
        type="test_pour_task_sequence.py"
        name="test_pour_task_sequence"
        output="screen">
    <param name="fixed_grasp_yaml" value="$(arg fixed_grasp_yaml)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="end_effector_topic" value="$(arg end_effector_topic)" />
    <param name="limb" value="$(arg limb)" />
    <param name="execution_state_topic" value="/intent_inference/execution_state" />
    <param name="selected_grasp_label_topic" value="$(arg selected_grasp_label_topic)" />
    <param name="publish_rate_hz" value="$(arg publish_rate_hz)" />
    <param name="wait_for_grasp_complete" value="true" />
    <param name="grasp_complete_label" value="side_grasp_milk" />
    <param name="carry_grasp_id" value="$(arg carry_grasp_id)" />
    <param name="carry_stage" value="$(arg carry_stage)" />
    <param name="pre_pour_grasp_id" value="$(arg pre_pour_grasp_id)" />
    <param name="pre_pour_stage" value="$(arg pre_pour_stage)" />
    <param name="pour_grasp_id" value="$(arg pour_grasp_id)" />
    <param name="pour_stage" value="$(arg pour_stage)" />
    <param name="return_grasp_id" value="$(arg return_grasp_id)" />
    <param name="return_stage" value="$(arg return_stage)" />
    <param name="place_back_grasp_id" value="$(arg place_back_grasp_id)" />
    <param name="place_back_stage" value="$(arg place_back_stage)" />
    <param name="start_hold_sec" value="$(arg start_hold_sec)" />
    <param name="hover_hold_sec" value="$(arg hover_hold_sec)" />
    <param name="pre_pour_move_sec" value="$(arg pre_pour_move_sec)" />
    <param name="pre_pour_hold_sec" value="$(arg pre_pour_hold_sec)" />
    <param name="pour_move_sec" value="$(arg pour_move_sec)" />
    <param name="pour_hold_sec" value="$(arg pour_hold_sec)" />
    <param name="return_move_sec" value="$(arg return_move_sec)" />
    <param name="return_hold_sec" value="$(arg return_hold_sec)" />
    <param name="return_lift_move_sec" value="$(arg return_lift_move_sec)" />
    <param name="return_lift_hold_sec" value="$(arg return_lift_hold_sec)" />
    <param name="place_back_move_sec" value="$(arg place_back_move_sec)" />
    <param name="release_hold_sec" value="$(arg release_hold_sec)" />
    <param name="final_hold_sec" value="$(arg final_hold_sec)" />
    <param name="safe_hover_offset_z" value="$(arg safe_hover_offset_z)" />
    <param name="safe_travel_min_z" value="$(arg safe_travel_min_z)" />
    <param name="place_release_offset_z" value="$(arg place_release_offset_z)" />
    <param name="return_lift_offset_z" value="$(arg return_lift_offset_z)" />
    <param name="enable_robot_interface" value="$(arg enable_robot_interface)" />
    <param name="enable_gripper_actions" value="$(arg enable_gripper_actions)" />
    <param name="auto_prepare_gripper" value="$(arg auto_prepare_gripper)" />
    <param name="loop_sequence" value="$(arg loop_sequence)" />
    <param name="required_control_mode" value="shared_autonomy" />
  </node>
</launch>

<?xml version="1.0"?>
<launch>
  <arg name="scene_name" default="scene_swapped"/>
  <arg name="setting_file_path" default="$(find relaxed_ik_ros1)/relaxed_ik_core/configs/settings.yaml"/>
  <arg name="with_rviz" default="true"/>
  <arg name="with_keyboard_teleop" default="true"/>
  <arg name="mujoco_gl" default="osmesa"/>
  <arg name="electric_gripper" default="true"/>

  <arg name="scene_xml_path" default="$(find tabletop_workspace_opt)/src/assets/scenes/$(arg scene_name).xml"/>
  <arg name="camera_name" default="realsense_rgb"/>
  <arg name="camera_mount_frame" default="realsense_link"/>
  <arg name="camera_frame" default="realsense_color_optical_frame"/>
  <arg name="base_frame" default="world"/>
  <arg name="tip_link" default="right_l6"/>
  <arg name="tip_to_cam_x" default="0.0"/>
  <arg name="tip_to_cam_y" default="0.05"/>
  <arg name="tip_to_cam_z" default="0.07"/>
  <arg name="tip_to_cam_qx" default="0.7071068"/>
  <arg name="tip_to_cam_qy" default="-0.7071068"/>
  <arg name="tip_to_cam_qz" default="0.0"/>
  <arg name="tip_to_cam_qw" default="0.0"/>
  <arg name="graspnet_root" default="$(optenv GRASPNET_ROOT /home/yi-shiuan/sawyer_ws/src/graspnet-baseline)"/>
  <arg name="checkpoint_path" default="$(arg graspnet_root)/checkpoint-rs.tar"/>
  <arg name="process_rate_hz" default="1.0"/>
  <arg name="camera_startup_delay_sec" default="3.0"/>
  <arg name="camera_wait_timeout_sec" default="30.0"/>
  <arg name="candidate_top_k" default="10"/>
  <arg name="workspace_min_depth_m" default="0.05"/>
  <arg name="workspace_max_depth_m" default="1.5"/>
  <arg name="candidate_z_min" default="0.72"/>
  <arg name="candidate_z_max" default="1.02"/>
  <arg name="selector_candidate_topic" default="/shared_autonomy/candidate_grasps"/>
  <arg name="visualizer_candidate_topic" default="$(arg selector_candidate_topic)"/>
  <arg name="high_z_penalty_start" default="0.92"/>
  <arg name="high_z_penalty_scale" default="0.08"/>
  <arg name="w_high_z_penalty" default="0.25"/>

  <param name="setting_file_path" value="$(arg setting_file_path)"/>
  <param name="use_simulator" value="true"/>
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder $(find sawyer_description)/urdf/sawyer.urdf.xacro electric_gripper:=$(arg electric_gripper)"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_base"
        args="0 0 0.92 0 0 0 1 world base"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_base_link"
        args="0 0 0 0 0 0 1 base base_link"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="tip_to_camera_mount"
        args="$(arg tip_to_cam_x) $(arg tip_to_cam_y) $(arg tip_to_cam_z) $(arg tip_to_cam_qx) $(arg tip_to_cam_qy) $(arg tip_to_cam_qz) $(arg tip_to_cam_qw) $(arg tip_link) $(arg camera_mount_frame)"/>

  <!-- MuJoCo camera axes are not ROS optical axes; convert to optical frame explicitly. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_mount_to_optical"
        args="0 0 0 1 0 0 0 $(arg camera_mount_frame) $(arg camera_frame)"/>

  <node pkg="joint_state_publisher" type="joint_state_publisher"
        name="joint_state_publisher" output="screen">
    <rosparam param="source_list">[/relaxed_ik/joint_angle_solutions]</rosparam>
    <rosparam param="zeros">
      right_j0: 0.0
      right_j1: -1.1775
      right_j2: 0.0
      right_j3: 2.1761
      right_j4: 0.0
      right_j5: 0.5663
      right_j6: 3.3124
    </rosparam>
    <param name="rate" value="30"/>
    <param name="publish_default_positions" value="true"/>
  </node>

  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher" output="screen"/>

  <node pkg="tabletop_workspace_opt"
        type="static_scene_to_collision_objects.py"
        name="static_scene_visualizer"
        output="screen">
    <param name="scene_xml_path" value="$(arg scene_xml_path)"/>
    <param name="world_frame" value="world"/>
    <param name="only_free_bodies" value="false"/>
    <param name="use_apply_planning_scene" value="false"/>
    <param name="enable_topic_publish" value="false"/>
    <param name="mesh_as_bounding_box" value="false"/>
    <param name="publish_visual_markers" value="true"/>
    <param name="visual_marker_topic" value="/static_scene_visual_markers"/>
    <param name="keep_visual_markers_alive" value="true"/>
    <param name="visual_marker_republish_interval" value="1.0"/>
    <param name="startup_delay" value="1.0"/>
  </node>

  <node pkg="relaxed_ik_ros1" type="relaxed_ik_rust.py" name="relaxed_ik_rust" output="screen">
    <param name="use_visualization" value="false"/>
    <param name="set_robot_description" value="false"/>
  </node>

  <node pkg="tabletop_workspace_opt" type="simulation_server.py" name="simulator" output="screen">
    <param name="scene_name" value="$(arg scene_name)"/>
    <param name="headless" value="true"/>
    <param name="sim_rate_hz" value="200"/>
    <env name="MUJOCO_GL" value="$(arg mujoco_gl)"/>
    <rosparam param="object_names">
      - bowl_0_a430d997_0564_4fae_801b_c01693feeee6
      - cutting_board_0_e8afda3b_6dea_4bfc_859f_88a35bb623a0
      - kettle_0_32879d92_873b_4b4d_b373_7aa5fa9312b4
      - blender_0_0fbbacb52bde4dbaae1c7a34b2beb9c4
      - utensil_holder_0_9ade5e08_2b58_4b38_98cb_6d21b4ca3c12
      - rice_cooker_0_b2bd52d777364996962de21c9647b45b
      - toaster_0_f22562f0e0ff43618941d02542123196
    </rosparam>
  </node>

  <node if="$(arg with_keyboard_teleop)"
        pkg="tabletop_workspace_opt"
        type="keyboard_teleop_node.py"
        name="keyboard_teleop"
        output="screen"
        args="-l right"/>

  <node pkg="tabletop_workspace_opt"
        type="realsense_simulation_node.py"
        name="realsense_sim"
        output="screen">
    <param name="scene_xml_path" value="$(arg scene_xml_path)"/>
    <param name="camera_name" value="$(arg camera_name)"/>
    <param name="frame_id" value="$(arg camera_mount_frame)"/>
    <param name="optical_frame_id" value="$(arg camera_frame)"/>
    <param name="joint_state_topic" value="/joint_states"/>
    <param name="rate" value="10"/>
    <param name="width" value="640"/>
    <param name="height" value="480"/>
    <param name="pc_stride" value="2"/>
    <param name="z_min" value="0.05"/>
    <param name="z_max" value="2.0"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="shared_autonomy_ee_pose_bridge.py"
        name="shared_autonomy_ee_pose_bridge"
        output="screen">
    <param name="input_topic" value="/mujoco_sim/endpoint_state"/>
    <param name="output_topic" value="/shared_autonomy/ee_pose"/>
    <param name="output_frame" value="world"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="shared_autonomy_grasp_visualizer.py"
        name="shared_autonomy_grasp_visualizer"
        output="screen">
    <param name="world_frame" value="world"/>
    <param name="candidate_grasps_topic" value="$(arg visualizer_candidate_topic)"/>
    <param name="selected_grasp_topic" value="/shared_autonomy/selected_grasp"/>
    <param name="ee_pose_topic" value="/shared_autonomy/ee_pose"/>
    <param name="ee_vel_goals_topic" value="/relaxed_ik/ee_vel_goals"/>
    <param name="marker_topic" value="/shared_autonomy/markers"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="graspnet_realsense_node.py"
        name="graspnet_realsense_node"
        output="screen">
    <param name="graspnet_root" value="$(arg graspnet_root)"/>
    <param name="checkpoint_path" value="$(arg checkpoint_path)"/>
    <param name="color_topic" value="/realsense/color/image_raw"/>
    <param name="depth_topic" value="/realsense/depth/image_raw"/>
    <param name="camera_info_topic" value="/realsense/color/camera_info"/>
    <param name="depth_scale" value="1.0"/>
    <param name="workspace_min_depth_m" value="$(arg workspace_min_depth_m)"/>
    <param name="workspace_max_depth_m" value="$(arg workspace_max_depth_m)"/>
    <param name="camera_frame" value="$(arg camera_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="candidate_z_min" value="$(arg candidate_z_min)"/>
    <param name="candidate_z_max" value="$(arg candidate_z_max)"/>
    <param name="publish_to_relaxedik" value="false"/>
    <param name="visualize_in_rviz" value="false"/>
    <param name="continuous" value="true"/>
    <param name="interactive" value="false"/>
    <param name="process_rate_hz" value="$(arg process_rate_hz)"/>
    <param name="camera_startup_delay_sec" value="$(arg camera_startup_delay_sec)"/>
    <param name="camera_wait_timeout_sec" value="$(arg camera_wait_timeout_sec)"/>
    <param name="publish_candidate_grasps" value="true"/>
    <param name="candidate_grasp_topic" value="/shared_autonomy/candidate_grasps"/>
    <param name="candidate_grasp_top_k" value="$(arg candidate_top_k)"/>
    <param name="random_seed" value="0"/>
    <param name="enable_nms" value="true"/>
  </node>

  <node pkg="tabletop_workspace_opt"
        type="shared_autonomy_grasp_selector.py"
        name="shared_autonomy_grasp_selector"
        output="screen">
    <param name="base_frame" value="world"/>
    <param name="ee_pose_topic" value="/shared_autonomy/ee_pose"/>
    <param name="candidate_grasps_topic" value="$(arg selector_candidate_topic)"/>
    <param name="ee_vel_goals_topic" value="/relaxed_ik/ee_vel_goals"/>
    <param name="selected_grasp_topic" value="/shared_autonomy/selected_grasp"/>
    <param name="selected_grasp_pose_topic" value="/shared_autonomy/selected_grasp_pose"/>
    <param name="grasp_scores_topic" value="/shared_autonomy/grasp_scores"/>
    <param name="high_z_penalty_start" value="$(arg high_z_penalty_start)"/>
    <param name="high_z_penalty_scale" value="$(arg high_z_penalty_scale)"/>
    <param name="w_high_z_penalty" value="$(arg w_high_z_penalty)"/>
  </node>

  <node if="$(arg with_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz_scene_validation"
        args="-d $(find tabletop_workspace_opt)/config/camera_robot.rviz"
        output="screen"/>
</launch>

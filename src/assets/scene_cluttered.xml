<?xml version='1.0' encoding='utf-8'?>
<mujoco model="cluttered_scene">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81" impratio="10" />

  <!-- Higher friction to prevent sliding/spinning; stiffer contacts to prevent sinking into table -->
  <default>
    <geom friction="3.0 0.1 0.01" solref="0.005 1" solimp="0.99 0.999 0.001" condim="4" />
  </default>
  <include file="sawyer-gripper.xml" />

  <asset>
      <texture name="T_table" type="cube" file="textures/wood2.png" />
      <texture name="T_floor" type="2d" file="textures/floor2.png" />

      <material name="table_wood" texture="T_table" shininess=".3" specular="0.5" />
      <material name="table_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0" />

      <mesh file="../meshes/table/tablebody.stl" name="tablebody" scale="1 1 1"/>
      <mesh file="../meshes/table/tabletop.stl" name="tabletop" scale="1 1 1"/>
  </asset>

  <worldbody>
    <!-- Static RGB camera for VLM control: FRONT view from the far side of
         the table facing the robot, so the arm does not occlude the objects.
         NOTE the mirrored mapping: image-right = robot's +y (its left),
         image-left = robot's -y. The prompt tells the VLM this. -->
    <camera name="static_camera" pos="1.35 0 1.9" xyaxes="0 1 0 -0.785 0 0.620" fovy="45"/>
    <light name="key_light" pos="1.2 1.0 2.0" dir="-1 -1 -1" directional="true" diffuse="0.95 0.95 0.95" specular="0.25 0.25 0.25" castshadow="true" />
    <light name="fill_light" pos="-1.0 0.6 1.5" dir="1 -0.2 -1" directional="true" diffuse="0.45 0.45 0.45" specular="0.05 0.05 0.05" castshadow="false" />
    <geom name="ground" type="plane" size="2 2 0.1" pos="0 0 -0.001" rgba="0.2 0.2 0.2 1" />
    <body name="tablelink" pos="0.6 0 0.915" euler="0 0 1.5708">
      <geom name="tablelink" material="table_wood" group="1" type="box" size=".7 .4 .027" pos="0 0 -.027" conaffinity="0" contype="0" />
      <geom name="tablebody" material="table_wood" group="1" mesh="tablebody" pos="0 0 -0.65" type="mesh" conaffinity="0" contype="0" />
      <geom name="tabletop" material="table_col" group="4" pos="0.0 0.0 -0.46" size="0.7 0.4 0.46" type="box" conaffinity="1" contype="1" />
    </body>

    <!-- ===== Landmarks (non-grippable) ===== -->
    <body name="tray_left" pos="0.35 0.30 0.952">
      <geom name="tray_left_geom" type="box" size="0.10 0.08 0.01"
            rgba="0.3 0.4 0.7 1" contype="1" conaffinity="1" />
    </body>
    <body name="tray_right" pos="0.35 -0.30 0.952">
      <geom name="tray_right_geom" type="box" size="0.10 0.08 0.01"
            rgba="0.3 0.7 0.4 1" contype="1" conaffinity="1" />
    </body>
    <body name="bin_center" pos="0.75 0.0 0.972">
      <geom name="bin_center_geom" type="box" size="0.06 0.06 0.03"
            rgba="0.5 0.5 0.5 1" contype="1" conaffinity="1" />
    </body>

    <!-- ===== Grippable objects ===== -->
    <!-- red_block: box 50x40x50mm, z = 0.942 + 0.025 = 0.967 -->
    <body name="red_block" pos="0.40 0.15 0.967">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
      <geom name="red_block_collision" type="box" size="0.025 0.020 0.025"
            rgba="0.9 0.1 0.1 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- blue_block: box 40x50x60mm, z = 0.942 + 0.030 = 0.972 -->
    <body name="blue_block" pos="0.45 -0.10 0.972">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.25" diaginertia="0.001 0.001 0.001"/>
      <geom name="blue_block_collision" type="box" size="0.020 0.025 0.030"
            rgba="0.1 0.2 0.9 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- green_cylinder: 50mm dia, 100mm tall, z = 0.942 + 0.050 = 0.992 -->
    <body name="green_cylinder" pos="0.55 0.25 0.992">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.3" diaginertia="0.001 0.001 0.001"/>
      <geom name="green_cylinder_collision" type="cylinder" size="0.025 0.050"
            rgba="0.1 0.8 0.2 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- yellow_block: box 50x30x80mm, z = 0.942 + 0.040 = 0.982 -->
    <body name="yellow_block" pos="0.50 -0.25 0.982">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
      <geom name="yellow_block_collision" type="box" size="0.025 0.015 0.040"
            rgba="0.95 0.9 0.1 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- orange_cylinder: 40mm dia, 90mm tall, z = 0.942 + 0.045 = 0.987 -->
    <body name="orange_cylinder" pos="0.65 0.10 0.987">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.25" diaginertia="0.001 0.001 0.001"/>
      <geom name="orange_cylinder_collision" type="cylinder" size="0.020 0.045"
            rgba="1.0 0.5 0.0 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- purple_block: box 40x40x70mm, z = 0.942 + 0.035 = 0.977 -->
    <body name="purple_block" pos="0.70 -0.15 0.977">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
      <geom name="purple_block_collision" type="box" size="0.020 0.020 0.035"
            rgba="0.6 0.1 0.8 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- white_cylinder: 54mm dia, 80mm tall, z = 0.942 + 0.040 = 0.982 -->
    <body name="white_cylinder" pos="0.60 -0.35 0.982">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.3" diaginertia="0.001 0.001 0.001"/>
      <geom name="white_cylinder_collision" type="cylinder" size="0.027 0.040"
            rgba="0.95 0.95 0.95 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- pink_block: box 44x36x60mm, z = 0.942 + 0.030 = 0.972 -->
    <body name="pink_block" pos="0.75 0.30 0.972">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
      <geom name="pink_block_collision" type="box" size="0.022 0.018 0.030"
            rgba="1.0 0.4 0.6 1" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>
  </worldbody>

  <!-- Initial robot configuration so the arm doesn't sweep through objects on startup.
       qpos order: right_j0..j6 (7), gripper (2), then 11 freejoint bodies x 7 qpos each (pos+quat) = 77
       Total: 7 + 2 + 8*7 = 65 (only freejoint objects counted, landmarks have no joints) -->
  <keyframe>
    <key name="home" qpos="0.0 -1.1775 0.0 2.1761 0.0 0.5663 3.3124 0 0
      0.40 0.15 0.967 1 0 0 0
      0.45 -0.10 0.972 1 0 0 0
      0.55 0.25 0.992 1 0 0 0
      0.50 -0.25 0.982 1 0 0 0
      0.65 0.10 0.987 1 0 0 0
      0.70 -0.15 0.977 1 0 0 0
      0.60 -0.35 0.982 1 0 0 0
      0.75 0.30 0.972 1 0 0 0"/>
  </keyframe>

  <visual>
    <global offwidth="1280" offheight="960" />
    <quality shadowsize="4096" />
    <headlight ambient="0.30 0.30 0.30" diffuse="0.75 0.75 0.75" specular="0.15 0.15 0.15" />
    <map znear="0.01" zfar="50" />
  </visual>
</mujoco>

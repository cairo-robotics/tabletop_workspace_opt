<mujoco model="sawyer scene">
  <include file="sawyer-gripper.xml"/>
  <include file="block_dependencies.xml"/>
  <include file="wall_dependencies.xml"/>

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <asset>
      <texture name="T_table" type="cube" file="textures/wood2.png"/>
      <texture name="T_floor" type="2d" file="textures/floor2.png"/>

      <material name="table_wood" texture="T_table" shininess=".3" specular="0.5"/>
      <material name="table_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0"/>

      <mesh file="../meshes/table/tablebody.stl" name="tablebody" scale="1 1 1"/>
      <mesh file="../meshes/table/tabletop.stl" name="tabletop" scale="1 1 1"/>
  </asset>

  <asset>
      <texture name="T_wallmetal" type="cube" file="textures/metal.png"/>
      <material name="wall_metal" texture="T_wallmetal" shininess="1" reflectance="1" specular=".5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="tablelink" pos="0.6 0 0.915" euler="0 0 1.5708">
      <geom name="tablelink" material="table_wood" group="1" type="box" size=".7 .4 .027" pos="0 0 -.027" conaffinity="0"
            contype="0"/>
      <geom name="tablebody" material="table_wood" group="1" mesh="tablebody" pos="0 0 -0.65" type="mesh" conaffinity="0"
            contype="0"/>
      <geom name="tabletop" material="table_col" group="4" pos="0.0 0.0 -0.46" size="0.7 0.4 0.46" type="box" conaffinity="1"
            contype="0"/>
    </body>

    <body name="block1" pos="0.75 0.11 1.0"> <!-- Adjust height to be on the table -->
      <joint name="block1_joint" type="free" limited="false" damping="0." armature="0."/>
      <inertial mass="0.1" diaginertia="0.001 0.001 0.001" pos="0 0 0"/>
      <geom name="manip_object1" material="block_wood" type="box" size="0.02 0.02 0.02" pos="0 0 0" contype="1" conaffinity="1"/>
    </body>

    <body name="block2" pos="0.75 0.03 1.0"> <!-- Adjust height to be on the table -->
      <joint name="block2_joint" type="free" limited="false" damping="0." armature="0."/>
      <inertial mass="0.1" diaginertia="0.001 0.001 0.001" pos="0 0 0"/>
      <geom name="manip_object2" material="block_col" type="box" size="0.02 0.02 0.02" pos="0 0 0" contype="1" conaffinity="1"/>
    </body>

    <body name="block3" pos="0.75 -0.05 1.0"> <!-- Adjust height to be on the table -->
      <joint name="block3_joint" type="free" limited="false" damping="0." armature="0."/>
      <inertial mass="0.1" diaginertia="0.001 0.001 0.001" pos="0 0 0"/>
      <geom name="manip_object3" material="block_red" type="box" size="0.02 0.02 0.02" pos="0 0 0" contype="1" conaffinity="1"/>
    </body>

  </worldbody>
</mujoco>
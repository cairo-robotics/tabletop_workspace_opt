<?xml version='1.0' encoding='utf-8'?>
<mujoco model="kitchen_prep_scene_optimized">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81" impratio="10" />

  <default>
    <geom friction="3.0 0.1 0.01" solref="0.005 1" solimp="0.99 0.999 0.001" condim="4" />
  </default>
  <include file="sawyer-gripper.xml" />

  <asset>
    <texture name="T_table" type="cube" file="textures/wood2.png" />
    <texture name="T_floor" type="2d" file="textures/floor2.png" />
    <material name="table_wood" texture="T_table" shininess=".3" specular="0.5" />
    <material name="table_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0" />
    <mesh file="../meshes/table/tablebody.stl" name="tablebody" scale="1 1 1"/>
    <mesh file="../meshes/table/tabletop.stl" name="tabletop" scale="1 1 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="1.2 1.0 2.0" dir="-1 -1 -1" directional="true"
           diffuse="0.95 0.95 0.95" specular="0.25 0.25 0.25" castshadow="true" />
    <light name="fill_light" pos="-1.0 0.6 1.5" dir="1 -0.2 -1" directional="true"
           diffuse="0.45 0.45 0.45" specular="0.05 0.05 0.05" castshadow="false" />
    <geom name="ground" type="plane" size="2 2 0.1" pos="0 0 -0.001" rgba="0.2 0.2 0.2 1" />

    <!-- Table (same as breakfast scene) -->
    <body name="tablelink" pos="0.6 0 0.915" euler="0 0 1.5708">
      <geom name="tablelink" material="table_wood" group="1" type="box"
            size=".7 .4 .027" pos="0 0 -.027" conaffinity="0" contype="0" />
      <geom name="tablebody" material="table_wood" group="1" mesh="tablebody"
            pos="0 0 -0.65" type="mesh" conaffinity="0" contype="0" />
      <geom name="tabletop" material="table_col" group="4" pos="0.0 0.0 -0.46"
            size="0.7 0.4 0.46" type="box" conaffinity="1" contype="1" />
    </body>

    <!-- Cutting board (wooden, large flat box) -->
    <body name="cutting_board" pos="0.301 0.265 0.952">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.8" diaginertia="0.002 0.002 0.002"/>
      <geom name="cutting_board_visual" type="box" size="0.12 0.08 0.01"
            rgba="0.6 0.45 0.25 1" contype="0" conaffinity="0" />
      <geom name="cutting_board_col" type="box" size="0.12 0.08 0.01"
            rgba="1 1 1 0" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- Apple (red sphere, visual=sphere, collision=box for grasping) -->
    <body name="apple" pos="0.302 -0.173 0.980">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.0005 0.0005 0.0005"/>
      <geom name="apple_visual" type="sphere" size="0.038"
            rgba="0.8 0.15 0.1 1" contype="0" conaffinity="0" />
      <geom name="apple_col" type="box" size="0.028 0.028 0.028"
            rgba="1 1 1 0" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- Can (red cylinder, soup can) -->
    <body name="can" pos="0.848 -0.039 0.997">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.4" diaginertia="0.001 0.001 0.001"/>
      <geom name="can_visual" type="cylinder" size="0.033 0.055"
            rgba="0.7 0.1 0.1 1" contype="0" conaffinity="0" />
      <geom name="can_col" type="box" size="0.027 0.027 0.055"
            rgba="1 1 1 0" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- Bottle (green, tall cylinder) -->
    <body name="bottle" pos="0.659 0.264 1.037">
      <freejoint/>
      <inertial pos="0 0 -0.03" mass="0.6" diaginertia="0.002 0.002 0.002"/>
      <geom name="bottle_visual" type="cylinder" size="0.030 0.095"
            rgba="0.2 0.5 0.2 1" contype="0" conaffinity="0" />
      <geom name="bottle_col" type="box" size="0.025 0.025 0.095"
            rgba="1 1 1 0" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>

    <!-- Sponge (yellow, soft box) -->
    <body name="sponge" pos="0.695 -0.365 0.962">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.0003 0.0003 0.0003"/>
      <geom name="sponge_visual" type="box" size="0.05 0.025 0.02"
            rgba="1.0 0.85 0.2 1" contype="0" conaffinity="0" />
      <geom name="sponge_col" type="box" size="0.05 0.025 0.02"
            rgba="1 1 1 0" contype="1" conaffinity="1"
            friction="8.0 0.005 0.0001" />
    </body>
  </worldbody>

  <!-- qpos: 7 arm + 2 gripper + 5 objects x 7 (pos+quat) = 44 -->
  <keyframe>
    <key name="home" qpos="0 -1.177 0 2.176 0 0.566 3.312 0 0
      0.301 0.265 0.952 1.000 0 0 0
      0.302 -0.173 0.980 1.000 0 0 0
      0.848 -0.039 0.997 1.000 0 0 0
      0.659 0.264 1.037 1.000 0 0 0
      0.695 -0.365 0.962 1.000 0 0 0"/>
  </keyframe>

  <visual>
    <global offwidth="1280" offheight="960" />
    <quality shadowsize="4096" />
    <headlight ambient="0.30 0.30 0.30" diffuse="0.75 0.75 0.75"
              specular="0.15 0.15 0.15" />
    <map znear="0.01" zfar="50" />
  </visual>
</mujoco>

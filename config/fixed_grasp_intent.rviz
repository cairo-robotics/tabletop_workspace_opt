Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /RobotModel1
        - /PointCloud21
        - /MarkerArray1
        - /MarkerArray2
        - /Pose1
        - /PoseArray1
        - /PoseArray2
      Splitter Ratio: 0.5
    Tree Height: 420
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.12
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PointCloud2
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.006
      Style: Flat Squares
      Topic: /camera/depth/color/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /fixed_grasp_publisher/markers
      Name: FixedGraspMarkers
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /intent_inference/selection_markers
      Name: SelectorMarkers
      Queue Size: 100
      Value: true
    - Alpha: 1
      Axes Length: 0.12
      Axes Radius: 0.012
      Class: rviz/Pose
      Color: 255; 235; 59
      Enabled: true
      Head Length: 0.06
      Head Radius: 0.025
      Name: SelectedTopPose
      Shaft Length: 0.08
      Shaft Radius: 0.012
      Shape: Arrow
      Topic: /intent_inference/top_pose
      Unreliable: false
      Value: true
    - Alpha: 0.9000000357627869
      Class: rviz/PoseArray
      Color: 54; 191; 255
      Enabled: false
      Length: 0.08
      Name: PregraspPoses
      Queue Size: 10
      Radius: 0.01
      Shaft Length: 0.06
      Shaft Radius: 0.008
      Shape: Arrow
      Topic: /fixed_grasp_publisher/pregrasp_poses
      Unreliable: false
      Value: false
    - Alpha: 0.9000000357627869
      Class: rviz/PoseArray
      Color: 255; 115; 54
      Enabled: false
      Length: 0.06
      Name: GraspPoses
      Queue Size: 10
      Radius: 0.01
      Shaft Length: 0.045
      Shaft Radius: 0.007
      Shape: Arrow
      Topic: /fixed_grasp_publisher/grasp_poses
      Unreliable: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.1
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.55
        Y: 0.0
        Z: 0.15
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: base
      Value: Orbit (rviz)
      Yaw: 1.0
Window Geometry:
  Displays:
    collapsed: false
  Height: 960
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1420
  X: 120
  Y: 80
